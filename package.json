{
  "name": "vector",
  "private": true,
  "version": "0.4.1",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "rer dev",
    "build": "rer build",
    "preview": "rer preview",
    "typecheck": "tsc -b",
    "test": "pnpm test:markdown && pnpm test:worker",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:markdown": "vitest run --config vitest.markdown.config.ts",
    "verify": "rer verify",
    "typegen": "wrangler types src/worker-bindings.d.ts --env-interface VectorBindings --include-runtime=false --strict-vars=false",
    "test:runtime": "node tests/e2e/core-runtime.mjs",
    "test:dev": "node tests/e2e/dev-runtime.mjs",
    "sources:check": "node scripts/edition-authoring/cli.mjs check",
    "sources:lock": "node scripts/edition-authoring/cli.mjs lock",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "deploy:prepare": "node scripts/deployment/prepare.mjs",
    "deploy:health": "node scripts/owner.mjs health",
    "test:deployment": "node --test --test-concurrency=2 scripts/deployment/tests/*.test.mjs",
    "test:base-auth": "node tests/e2e/base-auth-runtime.mjs",
    "test:admin": "node --experimental-strip-types tests/e2e/admin-runtime.mjs",
    "test:collaboration": "node --experimental-strip-types tests/e2e/collaboration-runtime.mjs",
    "build:source": "pnpm typecheck && vite build && node sdk/package.mjs",
    "artifact:setup": "node scripts/deployment/controller.mjs setup",
    "artifact:deploy": "node scripts/deployment/controller.mjs deploy",
    "artifact:health": "node scripts/deployment/controller.mjs health",
    "test:installer": "node --test --test-concurrency=2 tests/installer/adapter.test.mjs tests/installer/teardown.test.mjs",
    "test:installer:native": "node tests/installer/native-proof.mjs",
    "test:installer:slow": "node tests/installer/native-proof.mjs --slow",
    "test:readme": "node --test --test-concurrency=2 tests/installer/readme.test.mjs",
    "test:dev:setup": "node tests/e2e/dev-setup.mjs",
    "test:dev:ci": "node tests/e2e/dev-ci.mjs",
    "sources:verify-base": "node scripts/edition-authoring/cli.mjs verify-base --offline",
    "test:access": "node tests/e2e/access-matrix.mjs",
    "test:mutation-refresh": "node tests/e2e/mutation-refresh-runtime.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:wave-b": "node tests/e2e/wave-b-runtime.mjs",
    "artifact:delivery": "node scripts/build-delivery-artifact.mjs",
    "import:issues": "node scripts/data/import-issues.mjs",
    "test:integrations": "node --import ./tests/e2e/integrations/register-loader.mjs tests/e2e/integration-runtime.mjs && node tests/e2e/integrations/outbound-loopback.mjs",
    "test:data": "node tests/e2e/data-runtime.mjs && node --import ./tests/e2e/integrations/register-loader.mjs tests/e2e/data-roundtrip.mjs",
    "test:public-site": "pnpm exec rer build --site && node tests/e2e/public-site-runtime.mjs",
    "integration:sync": "node scripts/sync-integration.mjs --write",
    "integration:check": "node scripts/sync-integration.mjs --check",
    "verify:build": "node scripts/verify.mjs",
    "verify:ci": "node scripts/verify.mjs --ci",
    "test:archive-upgrade": "node --test --test-concurrency=1 tests/installer/older-archive.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "drizzle-orm": "0.45.2",
    "highlight.js": "^11.12.0",
    "hono": "4.13.7",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-decode-string": "2.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/vitest-plugin": "1.1.2",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.94",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "marked": "18.0.14",
    "miniflare": "5.20260907.0-alpha",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.129.1"
  },
  "pnpm": {
    "overrides": {
      "@cloudflare/vitest-plugin>miniflare": "5.20260907.0-alpha",
      "miniflare>sharp": "0.35.5",
      "miniflare>undici": "7.29.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/just-every/run-vector"
  },
  "engines": {
    "node": "22.20.0",
    "pnpm": "10.12.4"
  }
}
